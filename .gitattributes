# 统一换行:仓库内一律 LF,避免 Windows 克隆(core.autocrlf=true)把 .md 转成 CRLF。
# 译文校验要求 LF,见 scripts/verify-claude-code-zh.mjs。
* text=auto eol=lf

# 明确按文本处理并锁 LF 的类型
*.md    text eol=lf
*.mjs   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.sh    text eol=lf
*.ps1   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.txt   text eol=lf
*.mmd   text eol=lf
*.tla   text eol=lf
*.cfg   text eol=lf
*.dot   text eol=lf
*.out   text eol=lf
*.exit  text eol=lf
*.tsv   text eol=lf
*.java  text eol=lf

# 二进制,不做换行转换
*.jpg   binary
*.png   binary
*.gif   binary
*.ico   binary
*.lock  binary